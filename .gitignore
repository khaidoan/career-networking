# Environment files (never commit real secrets; .env.example is the committed template)
.env
.env.local

# Runtime data and logs bind-mounted into the jobs container (keep the .gitkeep placeholders)
backend/data/**
!backend/data/**/
!backend/data/**/.gitkeep
backend/logs/**
!backend/logs/**/
!backend/logs/**/.gitkeep

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# OS / editor noise
.DS_Store
*.swp
