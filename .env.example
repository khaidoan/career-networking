# Career Networking environment template.
# Copy to .env at the repo root (`cp .env.example .env`) and replace every placeholder.
# .env is git-ignored and is the only runtime env file; both compose files load it.

# --- Database (PostgreSQL) ---
# The postgres container is initialised from the three DATABASE_* values below;
# keep them in sync with the URL. The host is the compose service name `postgres`.
CAREER_NETWORKING_DATABASE_URL=postgresql+psycopg://career_networking:change-me-db-password@postgres:5432/career_networking
CAREER_NETWORKING_DATABASE_DBNAME=career_networking
CAREER_NETWORKING_DATABASE_USERNAME=career_networking
CAREER_NETWORKING_DATABASE_PASSWORD=change-me-db-password

# --- App login (single user) ---
CAREER_NETWORKING_USERNAME=change-me-username
CAREER_NETWORKING_PASSWORD=change-me-password

# --- User identity (shown in the app and used for notifications) ---
CAREER_NETWORKING_FIRSTNAME=Jane
CAREER_NETWORKING_LASTNAME=Doe
CAREER_NETWORKING_EMAIL=jane.doe@example.com

# --- Job boards ---
CAREER_NETWORKING_LONG_COMMON_JOBBOARDS_PASSWORD=change-me-jobboards-password

# --- File storage (container paths; bind-mounted from backend/data and backend/logs) ---
CAREER_NETWORKING_RESUME_FOLDER=/opt/career_networking/resume
CAREER_NETWORKING_JOB_DATA=/opt/career_networking/jobs
CAREER_NETWORKING_LOG_FOLDER=/opt/career_networking/logs

# --- Session tokens (JWT) ---
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
#   or: python3 -c "import secrets; print(secrets.token_hex(32))"
CAREER_NETWORKING_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Session lifetime in minutes (10080 = 7 days).
CAREER_NETWORKING_JWT_EXPIRES_MINUTES=10080

# --- Login rate limiting (failed attempts per client IP) ---
CAREER_NETWORKING_LOGIN_MAX_ATTEMPTS=5
CAREER_NETWORKING_LOGIN_WINDOW_MINUTES=15
